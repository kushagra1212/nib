<!--
  nib for Windows, as an MSI.

  Per-user, into %LOCALAPPDATA%\Programs\nib: no administrator prompt, the
  same as every other promise nib makes about staying out of the way. Built by
  Scripts\windows\package.ps1 from the staged folder, which is passed in as
  StageDir and holds exactly what an install contains.

  The UpgradeCode never changes: it is what makes a newer MSI replace an older
  one instead of installing beside it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="nib"
           Manufacturer="nib"
           Version="$(Version)"
           UpgradeCode="6f0c9a57-2c55-4d43-9e1f-8a4b2f1c7d31"
           Scope="perUser"
           Compressed="yes"
           Language="1033">
    <SummaryInformation Description="nib, an offline writing assistant" />
    <MajorUpgrade DowngradeErrorMessage="A newer nib is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="nib.ico" SourceFile="$(sys.SOURCEFILEDIR)..\resources\nib.ico" />
    <Property Id="ARPPRODUCTICON" Value="nib.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kushagra1212/nib" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="nib" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Files Include="$(StageDir)\**" />
    </ComponentGroup>

    <Component Id="Shortcut" Directory="ProgramMenuFolder" Guid="b8f5d0a2-4c1e-4f7a-9d3b-2e6a1c5f8b90">
      <Shortcut Id="StartMenu" Name="nib" Description="Offline writing assistant"
                Target="[INSTALLFOLDER]nib.exe" WorkingDirectory="INSTALLFOLDER" Icon="nib.ico" />
      <!-- A per-user component needs a registry key as its key path. -->
      <RegistryValue Root="HKCU" Key="Software\nib" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="CleanInstall" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="CleanPrograms" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="nib">
      <ComponentGroupRef Id="App" />
      <ComponentRef Id="Shortcut" />
    </Feature>

    <!-- Start nib when the installer finishes, as a launch from the Start menu would. -->
    <CustomAction Id="Launch" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]nib.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="Launch" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 5" />
    </InstallExecuteSequence>
  </Package>
</Wix>

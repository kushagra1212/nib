#include <windows.h>

1 ICON "nib.ico"
1 RT_MANIFEST "nib.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "nib"
      VALUE "FileDescription", "nib - offline writing assistant"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "nib"
      VALUE "LegalCopyright", "GPL-3.0"
      VALUE "OriginalFilename", "nib.exe"
      VALUE "ProductName", "nib"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
